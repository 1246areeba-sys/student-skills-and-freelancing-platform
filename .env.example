# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.

# Database: SQLite is used by default (app.db). To use a different SQLite
# file, set DATABASE_URL to a sqlite:/// path, e.g. sqlite:///app.db
# (PostgreSQL is no longer supported by this project).
# DATABASE_URL=sqlite:///app.db

# Secret key used for session signing
SECRET_KEY=change-me-to-a-long-random-string

# Flask debug mode (0 = off, 1 = on)
FLASK_DEBUG=0

# Platform settings
PLATFORM_NAME=SkillBridge
PLATFORM_FEE_PERCENT=10
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216
